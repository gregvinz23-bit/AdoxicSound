<Window x:Class="AoIP_RX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AoIP RX" Height="492" Width="480" ResizeMode="NoResize"
        Background="#F2F2F2" Foreground="#111111" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="BgWindow" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="BgInput" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderInput" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="FgMain" Color="#111111"/>
        <SolidColorBrush x:Key="FgDim" Color="#555555"/>
        <SolidColorBrush x:Key="Accent" Color="#2AA9E0"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1A4E8A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1A4E8A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#777777"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#BFE3F5"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMain}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDark}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#111111"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="14,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFE3F5"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgWindow}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgMain}"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgMain}"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Pill" Width="44" Height="22" CornerRadius="11"
                                    Background="#444" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2AA9E0"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3DDC84"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BgWindow}">
        <TabControl Background="{DynamicResource BgWindow}" BorderThickness="0">
            <!-- ============ STREAM ============ -->
            <TabItem Header="Stream">
                <StackPanel HorizontalAlignment="Stretch" Margin="16" Background="{DynamicResource BgWindow}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Ready" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DetailText" Text="" HorizontalAlignment="Center"
                               Foreground="{DynamicResource FgDim}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <TextBox x:Name="UrlBox" Text="mms://" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="AddButton" Content="+ Add" Click="AddButton_Click"/>
                        <Button x:Name="RemoveButton" Content="Remove" Click="RemoveButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="StreamList" Height="90" Margin="0,4"
                             SelectionChanged="StreamList_SelectionChanged"/>

                    <Button x:Name="PlayStopButton" Content="▶  STREAM" FontSize="16" Padding="14,10"
                            Background="#2AA9E0" Click="PlayStopButton_Click" Margin="0,8"/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="L" Grid.Row="0" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="MeterL" Grid.Row="0" Grid.Column="1" Style="{StaticResource Meter}" Margin="4,2"/>
                        <TextBlock x:Name="DbL" Grid.Row="0" Grid.Column="2" Text="-∞ dB" FontFamily="Consolas"/>
                        <TextBlock Text="R" Grid.Row="1" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="MeterR" Grid.Row="1" Grid.Column="1" Style="{StaticResource Meter}" Margin="4,2"/>
                        <TextBlock x:Name="DbR" Grid.Row="1" Grid.Column="2" Text="-∞ dB" FontFamily="Consolas"/>
                    </Grid>
                    <TextBlock x:Name="StatsText" Text="Up --:--:-- · Drops 0 · Glitches 0 · Alarms 0" Foreground="{DynamicResource FgDim}" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                        <TextBlock x:Name="LifeText" Text="" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="StatsReset" Content="Reset" Click="StatsReset_Click" FontSize="10" Padding="6,1" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ============ LOGS ============ -->
            <TabItem Header="Logs">
                <Grid MaxWidth="640" HorizontalAlignment="Stretch" Margin="16" Background="{DynamicResource BgWindow}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ComboBox x:Name="LogFilter" Width="110" SelectionChanged="LogFilter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="INFO"/>
                            <ComboBoxItem Content="WARN"/>
                            <ComboBoxItem Content="ERROR"/>
                        </ComboBox>
                        <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True"
                                  VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource FgMain}"/>
                        <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"/>
                        <Button x:Name="ExportButton" Content="Export" Click="ExportButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LogList" Grid.Row="1" Margin="0,8" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- ============ SETTINGS ============ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgWindow}">
                <StackPanel HorizontalAlignment="Stretch" Margin="16">
                    <TextBlock Text="Output device" FontWeight="Bold"/>
                    <ComboBox x:Name="SetDeviceCombo" Margin="0,4,0,12"
                              SelectionChanged="DeviceCombo_SelectionChanged"/>
                    <TextBlock Text="Sample rate" FontWeight="Bold"/>
                    <ComboBox x:Name="RateCombo" Margin="0,4,0,12" SelectionChanged="RateCombo_SelectionChanged">
                        <ComboBoxItem Content="44100 Hz"/>
                        <ComboBoxItem Content="48000 Hz"/>
                        <ComboBoxItem Content="96000 Hz"/>
                    </ComboBox>
                    <CheckBox x:Name="ModeToggle" Content="Stable buffering (off = fast start)" Style="{StaticResource Toggle}"
                              Margin="0,6" Checked="ModeToggle_Changed" Unchecked="ModeToggle_Changed"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                        <CheckBox x:Name="AlarmToggle" Content="Alarm on silence / drop" Style="{StaticResource Toggle}"
                                  VerticalAlignment="Center" Checked="AlarmToggle_Changed" Unchecked="AlarmToggle_Changed"/>
                        <TextBlock Text="after" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox x:Name="SilenceCombo" Width="80" VerticalAlignment="Center"
                                  SelectionChanged="SilenceCombo_SelectionChanged">
                            <ComboBoxItem Content="10 s"/>
                            <ComboBoxItem Content="15 s"/>
                            <ComboBoxItem Content="30 s"/>
                            <ComboBoxItem Content="60 s"/>
                            <ComboBoxItem Content="120 s"/>
                            <ComboBoxItem Content="300 s"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="BalanceToggle" Content="Auto balance" Style="{StaticResource Toggle}"
                              Margin="0,6" Checked="BalanceToggle_Changed" Unchecked="BalanceToggle_Changed"/>
                    <CheckBox x:Name="TrayToggle" Content="Minimize to tray on close" Style="{StaticResource Toggle}"
                              Margin="0,6" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"/>
                    <CheckBox x:Name="BootToggle" Content="Start on system startup" Style="{StaticResource Toggle}"
                              Margin="0,6" Checked="BootToggle_Changed" Unchecked="BootToggle_Changed"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ABOUT ============ -->
            <TabItem Header="About">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center" Margin="16"
                            VerticalAlignment="Center" Background="{DynamicResource BgWindow}">
                    <Image x:Name="LogoImage" Width="150" HorizontalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="VersionText" Text="AoIP RX" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Developed by: Greg Vincent" HorizontalAlignment="Center" Margin="0,4"/>
                    <TextBlock Text="Description: A portable Windows receiver for live MMS and Shoutcast/Icecast radio — with auto-reconnect, accurate stereo meters, and automatic balance correction."
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="© 2026 Mantraix Software. All rights reserved"
                               HorizontalAlignment="Center" Margin="0,4" Foreground="{DynamicResource FgDim}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                        <Button x:Name="UpdateButton" Content="Check for updates" Click="UpdateButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateText" Text="" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
