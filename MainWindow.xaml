<Window x:Class="AoIP_RX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AoIP RX" Height="540" Width="760" MinWidth="640" MinHeight="440"
        Background="#121212" Foreground="#E0E0E0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A4E8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Pill" Width="44" Height="22" CornerRadius="11"
                                    Background="#444" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2AA9E0"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3DDC84"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl Background="#121212" BorderThickness="0">
            <!-- ============ STREAM ============ -->
            <TabItem Header="Stream">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center" Margin="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Ready" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DetailText" Text="" HorizontalAlignment="Center"
                               Foreground="#888" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <TextBox x:Name="UrlBox" Text="mms://" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="AddButton" Content="+ Add" Click="AddButton_Click"/>
                        <Button x:Name="RemoveButton" Content="Remove" Click="RemoveButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="StreamList" Height="90" Margin="0,4"
                             SelectionChanged="StreamList_SelectionChanged"/>

                    <Button x:Name="PlayStopButton" Content="▶  STREAM" FontSize="16" Padding="14,10"
                            Background="#2AA9E0" Click="PlayStopButton_Click" Margin="0,8"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                        <TextBlock Text="Output:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="DeviceCombo" Width="300"
                                  SelectionChanged="DeviceCombo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                        <RadioButton x:Name="FastRadio" Content="Fast" IsChecked="True"
                                     Checked="ModeRadio_Checked" Margin="0,0,12,0" Foreground="#E0E0E0"/>
                        <RadioButton x:Name="StableRadio" Content="Stable"
                                     Checked="ModeRadio_Checked" Foreground="#E0E0E0"/>
                    </StackPanel>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="L" Grid.Row="0" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="MeterL" Grid.Row="0" Grid.Column="1" Style="{StaticResource Meter}" Margin="4,2"/>
                        <TextBlock x:Name="DbL" Grid.Row="0" Grid.Column="2" Text="-∞ dB" FontFamily="Consolas"/>
                        <TextBlock Text="R" Grid.Row="1" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="MeterR" Grid.Row="1" Grid.Column="1" Style="{StaticResource Meter}" Margin="4,2"/>
                        <TextBlock x:Name="DbR" Grid.Row="1" Grid.Column="2" Text="-∞ dB" FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ LOGS ============ -->
            <TabItem Header="Logs">
                <Grid MaxWidth="640" HorizontalAlignment="Stretch" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ComboBox x:Name="LogFilter" Width="110" SelectionChanged="LogFilter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="INFO"/>
                            <ComboBoxItem Content="WARN"/>
                            <ComboBoxItem Content="ERROR"/>
                        </ComboBox>
                        <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True"
                                  VerticalAlignment="Center" Margin="8,0" Foreground="#E0E0E0"/>
                        <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"/>
                        <Button x:Name="ExportButton" Content="Export" Click="ExportButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LogList" Grid.Row="1" Margin="0,8" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- ============ SETTINGS ============ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center" Margin="16">
                    <TextBlock Text="Output device" FontWeight="Bold"/>
                    <ComboBox x:Name="SetDeviceCombo" Margin="0,4,0,12"
                              SelectionChanged="DeviceCombo_SelectionChanged"/>
                    <TextBlock Text="Sample rate" FontWeight="Bold"/>
                    <Slider x:Name="RateSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="1"
                            IsSnapToTickEnabled="True" Margin="0,4" ValueChanged="RateSlider_Changed"/>
                    <TextBlock x:Name="RateLabel" Text="48000 Hz" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <CheckBox x:Name="BalanceToggle" Content="Auto balance" Style="{StaticResource Toggle}"
                              Margin="0,6" Checked="BalanceToggle_Changed" Unchecked="BalanceToggle_Changed"/>
                    <CheckBox x:Name="TrayToggle" Content="Minimize to tray on close" Style="{StaticResource Toggle}"
                              Margin="0,6" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"/>
                    <CheckBox x:Name="BootToggle" Content="Start on system startup" Style="{StaticResource Toggle}"
                              Margin="0,6" Checked="BootToggle_Changed" Unchecked="BootToggle_Changed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                        <Button x:Name="OpenFolderButton" Content="Open data folder" Click="OpenFolderButton_Click"/>
                        <Button x:Name="ClearFavButton" Content="Clear favorites" Click="ClearFavButton_Click"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ABOUT ============ -->
            <TabItem Header="About">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center" Margin="16"
                            VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="180" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="AoIP RX v1.0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Developed by: Greg Vincent" HorizontalAlignment="Center" Margin="0,4"/>
                    <TextBlock Text="Description: A lightweight and modern audio receiver"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="© 2026 Greg Vincent. All rights reserved"
                               HorizontalAlignment="Center" Margin="0,4" Foreground="#888"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                        <Button x:Name="UpdateButton" Content="Check for updates" Click="UpdateButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateText" Text="" HorizontalAlignment="Center" Foreground="#888"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
