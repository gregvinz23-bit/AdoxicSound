<Window x:Class="AdoxicSound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adoxic Sound" Height="500" Width="580" ResizeMode="NoResize"
        Background="#F2F2F2" Foreground="#111111" FontFamily="Segoe UI">

    <Grid Background="{DynamicResource BgWindow}">
        <TabControl x:Name="MainTabs" Background="{DynamicResource BgWindow}" BorderThickness="0" Margin="0,30,0,0"
                    SelectionChanged="MainTabs_Changed" TabStripPlacement="Left">
            <!-- ============ STREAM ============ -->
            <TabItem Header="Receive">
                <StackPanel HorizontalAlignment="Stretch" Margin="8,8,12,8" Background="{DynamicResource BgWindow}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Text="Ready" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailText" Text="" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FgDim}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="UrlBox" Text="mms://" Margin="0,4"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="AddButton" Content="+ Add" Click="AddButton_Click"/>
                                <Button x:Name="RemoveButton" Content="Remove" Click="RemoveButton_Click"/>
                                <Button x:Name="LogsButton" Content="Logs" Click="LogsButton_Click"/>
                            </StackPanel>
                            <ListBox x:Name="StreamList" Height="90" Margin="0,4" DisplayMemberPath="Name"
                                     SelectionChanged="StreamList_SelectionChanged"/>
                            <TextBlock x:Name="EmptyHint" Text="No stations yet — paste a stream address above and press + Add."
                                       HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" FontSize="11"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,2" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="PlayStopButton" Content="▶  STREAM" FontSize="16" Padding="14,10"
                            Background="#2AA9E0" Click="PlayStopButton_Click" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="L" Grid.Row="0" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="0" Grid.Column="1" Margin="4,2">
                                    <ProgressBar x:Name="MeterL" Style="{StaticResource Meter}"/>
                                    <Rectangle x:Name="TickL" Width="2" Fill="#111111" HorizontalAlignment="Left" Opacity="0.85"/>
                                </Grid>
                                <TextBlock x:Name="DbL" Grid.Row="0" Grid.Column="2" Text="-∞ dB" FontFamily="Consolas"/>
                                <TextBlock Text="R" Grid.Row="1" HorizontalAlignment="Center"/>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="4,2">
                                    <ProgressBar x:Name="MeterR" Style="{StaticResource Meter}"/>
                                    <Rectangle x:Name="TickR" Width="2" Fill="#111111" HorizontalAlignment="Left" Opacity="0.85"/>
                                </Grid>
                                <TextBlock x:Name="DbR" Grid.Row="1" Grid.Column="2" Text="-∞ dB" FontFamily="Consolas"/>
                            </Grid>
                            <TextBlock x:Name="StatsText" Text="Up --:--:-- · Drops 0 · Glitches 0 · Alarms 0" Foreground="{DynamicResource FgDim}" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                                <TextBlock x:Name="LifeText" Text="" Foreground="{DynamicResource FgDim}" FontSize="11" VerticalAlignment="Center"/>
                                <Button x:Name="StatsReset" Content="Reset" Click="StatsReset_Click" FontSize="10" Padding="6,1" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ============ LOGS (separate window) ============ -->

            <!-- ============ SETTINGS (separate window) ============ -->

            <!-- ============ SEND ============ -->
            <TabItem Header="Send">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgWindow}">
                <StackPanel HorizontalAlignment="Stretch" Margin="16" Background="{DynamicResource BgWindow}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                        <Ellipse x:Name="SendDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SendStatus" Text="Off air" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SendDetail" Text="" HorizontalAlignment="Center"
                               Foreground="{DynamicResource FgDim}" Margin="0,0,0,8"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Server" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendTypeBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" SelectionChanged="SendField_Changed">
                            <ComboBoxItem Content="Icecast 2"/>
                            <ComboBoxItem Content="Shoutcast v2"/>
                            <ComboBoxItem Content="Shoutcast v1"/>
                        </ComboBox>
                        <TextBlock Text="Host" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SendHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" TextChanged="SendField_Changed"/>
                        <TextBlock Text="Port" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SendPort" Grid.Row="2" Grid.Column="1" Margin="0,2" TextChanged="SendField_Changed"/>
                        <TextBlock Text="Mount" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="SendMount" Grid.Row="2" Grid.Column="3" Margin="0,2" TextChanged="SendField_Changed"/>
                        <TextBlock Text="User" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SendUser" Grid.Row="3" Grid.Column="1" Margin="0,2" TextChanged="SendField_Changed"/>
                        <TextBlock Text="Pass" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <PasswordBox x:Name="SendPass" Grid.Row="3" Grid.Column="3" Margin="0,2" PasswordChanged="SendField_Changed"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Input level" HorizontalAlignment="Center" FontSize="11"/>
                        <ProgressBar x:Name="SendMeter" Grid.Column="1" Style="{StaticResource Meter}" Margin="4,2"/>
                        <TextBlock x:Name="SendDb" Grid.Column="2" Text="-∞ dB" FontFamily="Consolas"/>
                    </Grid>
                    <Button x:Name="GoLiveButton" Content="●  GO LIVE" FontSize="16" Padding="14,10"
                            Background="#2AA9E0" Click="GoLiveButton_Click" Margin="0,8"/>
                    <Button x:Name="SendLogsButton" Content="Logs" Click="SendLogsButton_Click"
                            HorizontalAlignment="Center" Padding="20,4" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SendStats" Text="" HorizontalAlignment="Center"
                               Foreground="{DynamicResource FgDim}" FontSize="11"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ RECORD ============ -->
            <TabItem Header="Record">
                <StackPanel HorizontalAlignment="Stretch" Margin="16" Background="{DynamicResource BgWindow}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                        <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RecStatus" Text="Not recording" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="RecFile" Text="" HorizontalAlignment="Center"
                               Foreground="{DynamicResource FgDim}" Margin="0,0,0,8"/>
                    <Button x:Name="RecButton" Content="●  RECORD" FontSize="16" Padding="14,10"
                            Background="#2AA9E0" Click="RecButton_Click" Margin="0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="RecOpenFolder" Content="Open folder" Click="RecOpenFolder_Click"/>
                    </StackPanel>
                    <ListBox x:Name="RecFiles" Height="80" Margin="0,4"/>
                </StackPanel>
            </TabItem>

            <!-- ============ ABOUT ============ -->
            <TabItem Header="About">
                <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Center" Margin="12">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center" Background="Transparent">
                    <Image x:Name="LogoImage" Width="110" HorizontalAlignment="Center" Margin="0,4,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="VersionText" Text="Adoxic Sound" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Live internet radio studio: receive MMS and Shoutcast/Icecast, or broadcast your mic."
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Support: MantraixSoftwareSolutions@gmail.com" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock Text="2026 Mantraix Software Solution. All Rights Reserved"
                               HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="0,0,0,8"/>
                    <Button x:Name="UpdateButton" Content="Check for updates" Click="UpdateButton_Click"
                            HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="UpdateText" Text="" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,3,8,0">
            <Button x:Name="SettingsButton" Content="⚙" Click="SettingsButton_Click"
                    FontSize="13" Padding="10,1" Margin="2,0" ToolTip="Settings"/>
        </StackPanel>
    </Grid>
</Window>
