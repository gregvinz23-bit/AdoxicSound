<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AoIP_RX</RootNamespace>
    <AssemblyName>AoIP-RX</AssemblyName>
    <Version>1.3.0</Version>
    <Company>Mantraix Software</Company>
    <Product>AoIP RX</Product>
    <Description>A portable Windows receiver for live MMS and Shoutcast/Icecast radio</Description>
    <Copyright>� 2026 Mantraix Software. All rights reserved</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <ApplicationIcon>AoIP_RX_Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Logo.png" />
    <Resource Include="AoIP_RX_Icon.ico" />
  </ItemGroup>

  <!-- Audio-only VLC diet: drop video/subtitle/stream-out/discovery plugins + video-only codecs -->
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="plugins\video_output\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\video_filter\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\video_chroma\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\video_splitter\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\d3d11\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\d3d9\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\spu\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\text_renderer\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\visualization\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_out\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\access_output\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\services_discovery\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\mux\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libvpx_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libaom_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libx26410b_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libdav1d_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libschroedinger_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libtheora_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libdxva2_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libd3d11va_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libjpeg_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libpng_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libsdl_image_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libass_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libqsv_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libcrystalhd_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\librawvideo_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\librtpvideo_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libzvbi_plugin.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

</Project>
