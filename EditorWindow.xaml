<Window x:Class="AdoxicSound.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Editor" Height="480" Width="760" MinWidth="560" MinHeight="360"
        Background="#F2F2F2" Foreground="#111111" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- transport bar -->
        <StackPanel Orientation="Horizontal" Margin="10,8" VerticalAlignment="Center">
            <TextBlock Text="File" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="EdPlay" Content="▶" Click="EdPlay_Click" Padding="12,2" IsEnabled="False" ToolTip="Coming soon"/>
            <Button x:Name="EdStop" Content="■" Click="EdStop_Click" Padding="12,2" IsEnabled="False" ToolTip="Coming soon"/>
            <Button x:Name="EdHome" Content="⏮" Click="EdHome_Click" Padding="12,2" IsEnabled="False" ToolTip="Coming soon"/>
            <TextBlock x:Name="EdTime" Text="00:00.0 / --:--" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Consolas"/>
        </StackPanel>
        <!-- files + waveform -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Files" Margin="0,0,8,0">
                <ListBox x:Name="EdFiles" SelectionChanged="EdFiles_Changed"/>
            </GroupBox>
            <Border Grid.Column="1" BorderBrush="#AAAAAA" BorderThickness="1" Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EdRuler" Text="00:00          03:00          06:00" FontSize="10"
                               Foreground="#555555" Margin="30,2,4,0" FontFamily="Consolas"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="dB&#x0a;0&#x0a;&#x0a;-∞" FontSize="10" Foreground="#555555"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Margin="0,4,4,4" Background="#F7F7F7">
                            <TextBlock Text="Waveform coming soon — select a file on the left."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- bottom bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,8" VerticalAlignment="Center">
            <TextBlock x:Name="EdSel" Text="Sel --:--–--:--" VerticalAlignment="Center" FontFamily="Consolas"/>
            <Button x:Name="EdTrim" Content="Trim" Click="EdTrim_Click" IsEnabled="False" ToolTip="Coming soon"/>
            <Button x:Name="EdSave" Content="Save As" Click="EdSave_Click" IsEnabled="False" ToolTip="Coming soon"/>
            <TextBlock x:Name="EdFmt" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555555"/>
        </StackPanel>
    </Grid>
</Window>
