<Window x:Class="AdoxicSound.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="480" Width="400" ResizeMode="NoResize"
        Background="#F2F2F2" Foreground="#111111" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Style="{StaticResource Card}" Margin="8">
    <TabControl>
        <TabItem Header="Receive">
            <StackPanel Margin="10">
                <TextBlock Text="Output device" FontWeight="Bold"/>
                <ComboBox x:Name="SetDeviceCombo" Margin="0,4,0,12"
                          SelectionChanged="DeviceCombo_SelectionChanged"/>
                <TextBlock Text="Sample rate" FontWeight="Bold"/>
                <ComboBox x:Name="RateCombo" Margin="0,4,0,12" SelectionChanged="RateCombo_SelectionChanged">
                    <ComboBoxItem Content="44100 Hz"/>
                    <ComboBoxItem Content="48000 Hz"/>
                    <ComboBoxItem Content="96000 Hz"/>
                </ComboBox>
                <CheckBox x:Name="ModeToggle" Content="Stable buffering (off = fast start)" Style="{StaticResource Toggle}"
                          Margin="0,6" Checked="ModeToggle_Changed" Unchecked="ModeToggle_Changed"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                    <CheckBox x:Name="AlarmToggle" Content="Alarm on silence / drop" Style="{StaticResource Toggle}"
                              VerticalAlignment="Center" Checked="AlarmToggle_Changed" Unchecked="AlarmToggle_Changed"/>
                    <TextBlock Text="after" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="SilenceCombo" Width="80" VerticalAlignment="Center"
                              SelectionChanged="SilenceCombo_SelectionChanged">
                        <ComboBoxItem Content="10 s"/>
                        <ComboBoxItem Content="15 s"/>
                        <ComboBoxItem Content="30 s"/>
                        <ComboBoxItem Content="60 s"/>
                        <ComboBoxItem Content="120 s"/>
                        <ComboBoxItem Content="300 s"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="TrayToggle" Content="Minimize to tray on close" Style="{StaticResource Toggle}"
                          Margin="0,6" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"/>
                <CheckBox x:Name="BootToggle" Content="Start on system startup" Style="{StaticResource Toggle}"
                          Margin="0,6" Checked="BootToggle_Changed" Unchecked="BootToggle_Changed"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Send">
            <StackPanel Margin="10">
                <TextBlock Text="Input device" FontWeight="Bold"/>
                <ComboBox x:Name="SendInputBox" Margin="0,4,0,12" SelectionChanged="SendInput_Changed"/>
                <TextBlock Text="Stream bitrate" FontWeight="Bold"/>
                <ComboBox x:Name="SendRateBox" Margin="0,4,0,12" SelectionChanged="SendRate_Changed">
                    <ComboBoxItem Content="64 kbps"/><ComboBoxItem Content="96 kbps"/>
                    <ComboBoxItem Content="128 kbps"/><ComboBoxItem Content="160 kbps"/>
                    <ComboBoxItem Content="320 kbps"/>
                </ComboBox>
                <TextBlock Text="Channels" FontWeight="Bold"/>
                <ComboBox x:Name="SendChBox" Margin="0,4,0,12" SelectionChanged="SendCh_Changed">
                    <ComboBoxItem Content="Auto (follow input)"/>
                    <ComboBoxItem Content="Force mono"/>
                    <ComboBoxItem Content="Force stereo"/>
                </ComboBox>
                <TextBlock Text="Silence cutoff (auto-stop)" FontWeight="Bold"/>
                <ComboBox x:Name="SendCutBox" Margin="0,4,0,12" SelectionChanged="SendCut_Changed">
                    <ComboBoxItem Content="Off"/>
                    <ComboBoxItem Content="After 5 silent min"/>
                    <ComboBoxItem Content="After 15 silent min"/>
                    <ComboBoxItem Content="After 30 silent min"/>
                    <ComboBoxItem Content="After 60 silent min"/>
                </ComboBox>
                <TextBlock Text="Reconnect every" FontWeight="Bold"/>
                <ComboBox x:Name="SendRetryBox" Margin="0,4,0,12" SelectionChanged="SendRetry_Changed">
                    <ComboBoxItem Content="4 seconds"/>
                    <ComboBoxItem Content="10 seconds"/>
                    <ComboBoxItem Content="30 seconds"/>
                </ComboBox>
                <CheckBox x:Name="GoLiveBootToggle" Content="Go live on startup" Style="{StaticResource Toggle}"
                          Margin="0,6" Checked="GoLiveBoot_Changed" Unchecked="GoLiveBoot_Changed"/>
                <TextBlock Text="Server connection details stay on the Send tab."
                           Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" Margin="0,8"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Record">
            <StackPanel Margin="10">
                <TextBlock Text="Input device" FontWeight="Bold"/>
                <ComboBox x:Name="RecInputBox" Margin="0,4,0,12" SelectionChanged="RecInput_Changed"/>
                <TextBlock Text="Format" FontWeight="Bold"/>
                <ComboBox x:Name="RecFormatBox" Margin="0,4,0,12" SelectionChanged="RecFormat_Changed">
                    <ComboBoxItem Content="MP3"/>
                    <ComboBoxItem x:Name="RecAacItem" Content="AAC"/>
                    <ComboBoxItem Content="WAV"/>
                </ComboBox>
                <TextBlock Text="Quality" FontWeight="Bold"/>
                <ComboBox x:Name="RecRateBox" Margin="0,4,0,12" SelectionChanged="RecRate_Changed">
                    <ComboBoxItem Content="64 kbps"/><ComboBoxItem Content="96 kbps"/>
                    <ComboBoxItem Content="128 kbps"/><ComboBoxItem Content="160 kbps"/>
                    <ComboBoxItem Content="320 kbps"/>
                </ComboBox>
                <TextBlock Text="Save folder" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <TextBox x:Name="RecFolderBox" Width="250" Margin="0,0,6,0" TextChanged="RecFolder_Changed"/>
                    <Button x:Name="RecBrowse" Content="Browse" Click="RecBrowse_Click"/>
                </StackPanel>
                <TextBlock Text="Empty folder = portable records\ next to the app."
                           Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"/>
                <TextBlock Text="Split every" FontWeight="Bold" Margin="0,6,0,0"/>
                <ComboBox x:Name="RecSplitBox" Margin="0,4,0,0" SelectionChanged="RecSplit_Changed">
                    <ComboBoxItem Content="20 minutes"/>
                    <ComboBoxItem Content="30 minutes"/>
                    <ComboBoxItem Content="60 minutes"/>
                    <ComboBoxItem Content="Off (one file per session)"/>
                </ComboBox>
                <CheckBox x:Name="RecAutoToggle" Content="Auto record at startup" Style="{StaticResource Toggle}"
                          Margin="0,6" Checked="RecAuto_Changed" Unchecked="RecAuto_Changed"/>
            </StackPanel>
        </TabItem>
    </TabControl>
    </Border>
    </ScrollViewer>
</Window>
